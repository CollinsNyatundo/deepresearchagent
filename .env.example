# Deep Research Agent — Environment Variables
# Copy this file to .env and fill in your keys.
# All values can be overridden per-request via the API body or CLI flags.

# ── LLM Providers ────────────────────────────────────────────────────
# Required: OpenRouter (default provider — free tier available)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: Groq (ultra-fast inference, free tier 12k TPM)
# Switch via: LLM_PROVIDER=groq  or  --provider groq in CLI
GROQ_API_KEY=gsk_your-key-here

# ── Search Providers ─────────────────────────────────────────────────
# Optional: Tavily (higher quality results)
TAVILY_API_KEY=tvly-your-key-here

# Optional: Brave Search
BRAVE_SEARCH_API_KEY=BSA-your-key-here

# ── GitHub Code Research ─────────────────────────────────────────────
# Required for --mode github
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your-token-here

# ── Runtime Overrides (can also be set in config.toml) ───────────────
# LLM provider: openrouter | groq
# LLM_PROVIDER=openrouter

# Default model (OpenRouter format: provider/model)
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Search provider: duckduckgo | tavily | brave | all
# SEARCH_PROVIDER=all

# Graphify knowledge graph
# GRAPHIFY_ENABLED=true
# GRAPHIFY_MODE=deep         # fast (AST only) | deep (AST + LLM edges)
# GRAPHIFY_MCP_ENABLED=true
